{
  "name": "lore-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "collector": "cargo build --release -p lore-cli && mkdir -p src-tauri/binaries && cp ../target/release/lore \"src-tauri/binaries/lore-collector-$(rustc -vV | sed -n 's/^host: //p')\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
