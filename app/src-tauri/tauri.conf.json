{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lore",
  "version": "0.1.0",
  "identifier": "dev.lore.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run collector"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "lore",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "followsWindowActiveState",
          "radius": 10.0
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/lore-collector"]
  }
}
